---
import BaseLayout from '../layouts/BaseLayout.astro';

const tracks = [
  {
    id: '1186399666',
    color: '748490',
    title: 'Dedikacija',
    url: 'https://soundcloud.com/angsters/dedikacija',
  },
  {
    id: '1186385470',
    color: '788494',
    title: 'Slobodan Rad',
    url: 'https://soundcloud.com/angsters/slobodan-rad',
  },
  {
    id: '1186397209',
    color: '748490',
    title: 'Držite se, gospodine',
    url: 'https://soundcloud.com/angsters/drzite-se-gospodine-1',
  },
];

const socialLinks = [
  ['YouTube', 'https://www.youtube.com/channel/UChVE8OsJIOuqndJiMqRuEsA'],
  ['SoundCloud', 'https://soundcloud.com/angsters?utm_source=clipboard&utm_medium=text&utm_campaign=social_sharing'],
  ['Bandcamp', 'https://angsters.bandcamp.com/'],
  ['Instagram', 'https://www.instagram.com/theangsters/'],
];
---

<BaseLayout>
  <main class="flex h-full w-full flex-col p-6 backdrop-blur-lg md:w-[500px] md:p-10">
    <div>
      <h1 class="mb-8 text-3xl font-extrabold leading-none tracking-tight sm:text-4xl lg:text-6xl">
        ANGSTERS
      </h1>
      <p class="mb-6 text-gray-500 dark:text-white/60">
        With the members' diverse musical tastes, their music is probably best described as fusion. Or indie. Maybe alternative rock?
      </p>
    </div>

    <div class="my-10 space-y-4">
      {
        tracks.map((track) => (
          <div>
            <iframe
              width="100%"
              height="20"
              class="border-0"
              allow="autoplay"
              src={`https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/${track.id}&color=%23${track.color}&inverse=true&auto_play=false&show_user=true`}
              title={`Angsters - ${track.title}`}
            />
            <div class="truncate text-[10px] font-thin text-[#cccccc] [font-family:Interstate,Lucida_Grande,Lucida_Sans_Unicode,Lucida_Sans,Garuda,Verdana,Tahoma,sans-serif]">
              <a class="text-[#cccccc] no-underline" href="https://soundcloud.com/angsters" title="Angsters" target="_blank" rel="noreferrer">
                Angsters
              </a>
              {' · '}
              <a class="text-[#cccccc] no-underline" href={track.url} title={track.title} target="_blank" rel="noreferrer">
                {track.title}
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <div class="my-10 -mx-5">
      <a
        href="https://www.songkick.com/artists/10162291"
        class="songkick-widget"
        data-theme="dark"
        data-detect-style="true"
        data-background-color="transparent"
        data-locale="en"
      >
        Angsters tour dates
      </a>
      <script is:inline src="https://widget.songkick.com/10162291/widget.js"></script>
    </div>

    <footer class="mt-auto">
      <ul class="flex flex-wrap gap-x-4 gap-y-2">
        {
          socialLinks.map(([label, href]) => (
            <li>
              <a href={href} target="_blank" rel="noreferrer">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </footer>
  </main>
</BaseLayout>
